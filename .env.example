# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Automatically initialized to the Cloud Run deployment endpoint of DBMastery Studio.
APP_URL="https://ais-dev-h6eqy53fseyudxnu7jirg2-142940148904.europe-west2.run.app"

# VITE_SITE_ACCESS_PASSWORD: Mot de passe d'accès au portail (Étape 1 Netlify).
VITE_SITE_ACCESS_PASSWORD="DBMASTERY-2026"

# ADMIN_NOTIFICATION_EMAIL: Adresse email administratrice recevant toutes les alertes de connexion.
ADMIN_NOTIFICATION_EMAIL="nouhailler@gmail.com"

# Configuration SMTP prête pour Gmail / Google Workspace (avec mot de passe d'application 16 caractères):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="nouhailler@gmail.com"
SMTP_PASS=""
SMTP_SECURE="true"
SMTP_FROM="DBMastery Studio <nouhailler@gmail.com>"

# Webhook optionnel (Slack, Discord, Zapier, Make, n8n):
NOTIFICATION_WEBHOOK_URL=""

