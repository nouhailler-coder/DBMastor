# =============================================================================
# DBMastery Studio — Environment Variables Template (Server-Side Only)
# NEVER prefix secrets with VITE_ (VITE_* variables are bundled into browser JS).
# =============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI tutor & targeted sessions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where DBMastery Studio is served (used in links/redirects).
APP_URL="https://dbmastor.pages.dev"

