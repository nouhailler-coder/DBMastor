# ==============================================================================
# DBMastery Studio — Variables d'Environnement (.env.example)
# ==============================================================================
# IMPORTANT:
# - Ne jamais inscrire de secrets réels dans ce fichier exemple.
# - Les variables préfixées par VITE_ sont exposées au navigateur (client).
# - Les variables sans préfixe VITE_ sont strictement PRIVÉES et réservées au serveur (Node/Express).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES SERVEUR PRIVÉES (Obligatoires ou Recommandées)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY (Obligatoire pour les fonctions IA tuteur):
# Clé API Google Gemini pour les explications de pièges conceptuels et questions similaires.
# En environnement AI Studio, injecté automatiquement depuis les secrets utilisateur.
GEMINI_API_KEY=""

# PORT (Facultatif - Défaut: 3000):
# Port d'écoute du serveur Node.js / Express.
PORT="3000"

# APP_URL (Recommandé):
# URL canonique de déploiement de l'application (ex: Cloud Run / domaine personnalisé).
APP_URL="https://ais-dev-h6eqy53fseyudxnu7jirg2-142940148904.europe-west2.run.app"

# SITE_ACCESS_PASSWORD (Facultatif - Privé côté serveur, sans mot de passe par défaut):
# Mot de passe d'accès global au site si la protection par mot de passe serveur est activée.
# Laisser vide pour désactiver le verrouillage par mot de passe global.
SITE_ACCESS_PASSWORD=""

# ADMIN_NOTIFICATION_EMAIL (Recommandé):
# Adresse email administratrice recevant les alertes de connexion et de demandes d'accès.
ADMIN_NOTIFICATION_EMAIL="nouhailler@gmail.com"

# ------------------------------------------------------------------------------
# 2. CONFIGURATION SMTP PRIVÉE (Serveur Node.js)
# ------------------------------------------------------------------------------
# Utilisé pour l'envoi d'emails de notification d'accès et d'approbation.
# Ne jamais exposer ces paramètres au frontend.

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="nouhailler@gmail.com"
SMTP_PASS=""
SMTP_SECURE="true"
SMTP_FROM="DBMastery Studio <nouhailler@gmail.com>"

# NOTIFICATION_WEBHOOK_URL (Facultatif - Slack / Discord / Zapier / Make):
NOTIFICATION_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 3. VARIABLES CLIENT PUBLIQUES (Exposées dans le bundle navigateur)
# ------------------------------------------------------------------------------
# Attention: aucune valeur secrète ne doit figurer dans les variables VITE_*.
# Les identifiants Firebase client ci-dessous sont publics et régis par les règles Firestore.

VITE_FIREBASE_PROJECT_ID="ai-studio-dbmasterystudio-d8d9d0eb-2789-409f-934c-588a49abb7a0"
