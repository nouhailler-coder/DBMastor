# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_ACCESS_PASSWORD: Optional site-wide password required at Step 1 when deploying publicly (e.g., on Netlify).
# Defaults to "DBMASTERY-2026" if not set, and can also be customized in the Admin Access Control panel.
VITE_SITE_ACCESS_PASSWORD="DBMASTERY-2026"

# Email notifications for new access / connection requests:
ADMIN_NOTIFICATION_EMAIL="nouhailler@gmail.com"

# Optional SMTP configuration for automated email delivery to admin:
# (e.g. Gmail with App Password: host smtp.gmail.com, port 465, secure true)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="DBMastery Studio <notifications@dbmastery.app>"

# Optional Webhook URL (Slack, Discord, Zapier, Make, n8n, Formspree):
NOTIFICATION_WEBHOOK_URL=""

